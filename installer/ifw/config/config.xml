<?xml version="1.0" encoding="UTF-8"?>
<Installer>
  <Name>Win11 Extra Clock</Name>
  <Title>Win11 Extra Clock Setup</Title>
  <Version>@VERSION@</Version>
  <Publisher>Float Web</Publisher>
  <StartMenuDir>Win11 Extra Clock</StartMenuDir>
  <TargetDir>@ApplicationsDir@/Win11 Extra Clock</TargetDir>
  <RunProgram>@TargetDir@/Win11 Extra Clock.exe</RunProgram>
  <RunProgramDescription>Launch Win11 Extra Clock now</RunProgramDescription>

  <InstallerApplicationIcon>installer/assets/win11_extra_clock_icon.ico</InstallerApplicationIcon>

  <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
