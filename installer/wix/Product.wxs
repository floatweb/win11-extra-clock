<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="Win11 Extra Clock"
      Manufacturer="Float Web"
      Version="$(var.ProductVersion)"
      UpgradeCode="{47B46A15-4BB3-4303-8D2D-A410EC995E37}"
      InstallerVersion="500"
      Scope="perMachine">

    <util:SummaryInformation
        Title="Win11 Extra Clock Installer (x64)"
        Subject="Win11 Extra Clock"
        Keywords="Installer"
        Comments="MSI package for Win11 Extra Clock (x64)" />

    <MediaTemplate EmbedCab="yes"/>

    <Icon Id="AppIcon" SourceFile="assets\win11_extra_clock_icon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>

    <!-- WixUI: dialog set fără CA-uri by default în v6 -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR"/>

    <Feature Id="MainFeature" Title="Win11 Extra Clock" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="StartupShortcut"/>
    </Feature>

    <!-- Directoare țintă x64 -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Win11 Extra Clock"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcuts" Name="Win11 Extra Clock"/>
      </Directory>
      <Directory Id="StartupFolder"/>
    </Directory>

    <!-- Shortcuts -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Directory="AppShortcuts"
                  Name="Win11 Extra Clock"
                  Target="[INSTALLDIR]Win11 Extra Clock.exe"
                  WorkingDirectory="INSTALLDIR"
                  Advertise="no"/>
        <RemoveFolder Id="RemoveAppShortcuts" Directory="AppShortcuts" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\Win11ExtraClock" Name="sm" Type="integer" Value="1" KeyPath="yes"/>
      </Component>

      <Component Id="StartupShortcut" Guid="*">
        <Shortcut Id="StartupShortcut"
                  Directory="StartupFolder"
                  Name="Win11 Extra Clock"
                  Target="[INSTALLDIR]Win11 Extra Clock.exe"
                  WorkingDirectory="INSTALLDIR"
                  Advertise="no"/>
        <RegistryValue Root="HKCU" Key="Software\Win11ExtraClock" Name="su" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

  </Package>
</Wix>
