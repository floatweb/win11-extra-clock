<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="Win11 Extra Clock"
      Manufacturer="Float Web"
      Version="$(var.ProductVersion)"
      UpgradeCode="{47B46A15-4BB3-4303-8D2D-A410EC995E37}"
      Scope="perMachine">

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Win11 Extra Clock is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Win11 Extra Clock" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Win11 Extra Clock">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="Win11 Extra Clock"
                    Target="[INSTALLDIR]$(var.AppExeName)"
                    WorkingDirectory="INSTALLDIR" />
          <RemoveFolder Id="RemovePMDir" Directory="ProgramMenuDir" On="uninstall" />
          <util:RegistryValue Root="HKLM" Key="Software\Win11ExtraClock" Name="pm"
                              Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Shortcut Id="StartupShortcut"
                  Name="Win11 Extra Clock"
                  Target="[INSTALLDIR]$(var.AppExeName)"
                  WorkingDirectory="INSTALLDIR" />
        <util:RegistryValue Root="HKCU" Key="Software\Win11ExtraClock" Name="startup"
                            Type="integer" Value="1" KeyPath="yes" />
        <util:RegistryValue Root="HKCU"
                            Key="Software\Microsoft\Windows\CurrentVersion\Run"
                            Name="Win11 Extra Clock"
                            Value="&quot;[INSTALLDIR]$(var.AppExeName)&quot;"
                            Type="string" />
      </Component>
    </StandardDirectory>

    <?ifdef AppIconPath?>
      <Icon Id="AppIcon" SourceFile="$(var.AppIconPath)" />
      <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <?endif?>

    <Feature Id="MainFeature" Title="Win11 Extra Clock" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

  </Package>
</Wix>
