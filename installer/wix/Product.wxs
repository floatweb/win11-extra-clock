<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Win11 Extra Clock"
      Manufacturer="Float Web"
      Version="$(var.ProductVersion)"
      UpgradeCode="{47B46A15-4BB3-4303-8D2D-A410EC995E37}"
      Scope="perMachine">

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Win11 Extra Clock is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Win11 Extra Clock" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Win11 Extra Clock" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="Win11 Extra Clock"
                  Target="[INSTALLDIR]$(var.AppExeName)"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemovePMDir" Directory="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\Win11ExtraClock" Name="sm" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Shortcut Id="StartupShortcut"
                  Name="Win11 Extra Clock"
                  Target="[INSTALLDIR]$(var.AppExeName)"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\Win11ExtraClock" Name="startup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Win11 Extra Clock" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

  </Package>
</Wix>
