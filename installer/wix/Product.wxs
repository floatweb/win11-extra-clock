<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Win11 Extra Clock"
    Manufacturer="Float Web"
    Version="1.0.0"
    Language="1033"
    UpgradeCode="{47B46A15-4BB3-4303-8D2D-A410EC995E37}">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Win11 Extra Clock is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\win11_extra_clock_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_InstallDir" />

    <Feature Id="MainFeature" Title="Win11 Extra Clock" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="Win11 Extra Clock" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcuts" Name="Win11 Extra Clock" />
      </Directory>
      <Directory Id="StartupFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Shortcuts" Guid="*">
        <File Id="ExeFile" Source="$(var.SourceDir)\Win11 Extra Clock.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="AppShortcuts"
                    Name="Win11 Extra Clock"
                    WorkingDirectory="INSTALLDIR"
                    Advertise="no" />
          <Shortcut Id="StartupShortcut"
                    Directory="StartupFolder"
                    Name="Win11 Extra Clock"
                    WorkingDirectory="INSTALLDIR"
                    Advertise="no" />
        </File>
        <RemoveFolder Id="RemoveAppShortcuts" Directory="AppShortcuts" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Win11ExtraClock" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
