<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR" FileSource="!(bindpath.Payload)" />

    <ComponentGroup Id="AppFiles">
      <Files Directory="INSTALLDIR" Include="**\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
