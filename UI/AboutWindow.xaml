<Window x:Class="Win11_Extra_Clock.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="About"
        Width="560" Height="540"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" >

    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#1E1E1E" Opacity="0.94"/>
        <SolidColorBrush x:Key="FlyoutBorderBrush"     Color="#FFFFFF" Opacity="0.12"/>
        <SolidColorBrush x:Key="FlyoutForegroundBrush" Color="#F0FFFFFF"/>
        
        <sys:Double x:Key="FlyoutShadowOpacity">0.32</sys:Double>
        
        <Color x:Key="AccentColor">#FF4CC2FF</Color>
        <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentBrushHover"    Color="#FF5FD0FF"/>
        <SolidColorBrush x:Key="AccentBrushPressed"  Color="#FF2EA6E6"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="MinWidth"     Value="96"/>
            <Setter Property="Padding"      Value="12,16"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Foreground"   Value="{DynamicResource FlyoutForegroundBrush}"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource FlyoutBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        CornerRadius="3"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="Background"     Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush"    Value="{x:Null}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        CornerRadius="3"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Chrome" CornerRadius="14"
            Background="{DynamicResource FlyoutBackgroundBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1"
            Padding="18">


        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ScaleRt" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource FlyoutForegroundBrush}"/>
                </Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="{DynamicResource FlyoutForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource FlyoutBorderBrush}"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlyoutBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type Hyperlink}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
                <!-- logo -->
                <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0"
                        Background="#22FFFFFF">
                    <Image x:Name="LogoImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           Stretch="UniformToFill"
                           Margin="2" d:Source="/assets/win11_extra_clock_logo_02.png"/>
                </Border>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="HeaderTitle" d:Text="Win11 Extra Clock" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" d:Text="Version 1.0.0" Opacity="0.75" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- drag button -->
                <Border DockPanel.Dock="Top"
                        Width="40" Height="6" CornerRadius="3"
                        HorizontalAlignment="Center" Margin="0,0,0,6"
                        Background="{DynamicResource FlyoutBorderBrush}"/>
            </DockPanel>

            <Separator Grid.Row="0" Margin="0,44,0,0" Opacity="0.35"/>
>
            <StackPanel Grid.Row="1" Margin="2,12,2,12">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,10"
                           d:Text="A small utility that shows a seconds clock and the full long date when you open the Windows 11 calendar. You can also pin it for testing and position it including 'Custom'."/>

                <TextBlock x:Name="LicenseTitle" d:Text="License" FontWeight="SemiBold" Opacity="0.9" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.9" Margin="0,0,0,10">
                    <Run x:Name="LicenseBefore" d:Text="Released under the "/>
                    <Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl-3.0.en.html"
                               RequestNavigate="Hyperlink_RequestNavigate">GNU GPLv3</Hyperlink>
                    <Run x:Name="LicenseAfter" d:Text=". You may use, study, modify and redistribute this application under the same license."/>
                </TextBlock>

                <TextBlock x:Name="SourceHeader" d:Text="Source" FontWeight="SemiBold" Opacity="0.9" Margin="0,2,0,0"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.9" Margin="0,0,0,10">
                    <Run x:Name="SourceBefore" d:Text="Source available on "/>
                    <Hyperlink NavigateUri="https://github.com/floatweb/win11-extra-clock"
                               RequestNavigate="Hyperlink_RequestNavigate">GitHub</Hyperlink>
                    <Run x:Name="SourceAfter" d:Text="."/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <Image x:Name="GitHubImage"  Width="167" Height="36" Cursor="Hand"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           Stretch="Uniform"
                           ToolTip="GitHub" Margin="0,0,12,0" d:Source="/assets/github_light.png"/>
                </StackPanel>

                <TextBlock x:Name="SupportHeader" d:Text="Support" FontWeight="SemiBold" Opacity="0.9" Margin="0,6,0,0"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.9"  Margin="0,0,0,10">
                    <Run x:Name="SupportText" d:Text="Do you like this? Support the developer."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <Image x:Name="CoffeeImage"  Width="196" Height="44" Cursor="Hand"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           Stretch="Uniform"
                           ToolTip="Buy me a coffee"  d:Source="/assets/bmc.png"/>
                </StackPanel>

                <TextBlock x:Name="AuthorText" d:Text="Open-source by Float Web." TextWrapping="Wrap" Opacity="0.9"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource AccentButton}" d:Content="Close" Margin="0,-25,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>